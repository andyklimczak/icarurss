# Required in production
SECRET_KEY_BASE=replace-with-long-random-secret

# Optional
MIX_ENV=prod
PORT=4000
DATABASE_PATH=/data/icarurss_prod.db
REGISTRATION_ENABLED=false
FEED_REFRESH_SPREAD_WINDOW_SECONDS=600
FEED_FETCH_RECEIVE_TIMEOUT_MS=30000
MAX_FEED_BYTES=25000000
MAX_ITEMS_PER_FEED=500
OBAN_PRUNE_MAX_AGE_SECONDS=21600
OBAN_PRUNE_LIMIT=500
SQLITE_BUSY_TIMEOUT_MS=15000
STALE_FEED_JOB_TIMEOUT_SECONDS=3600
PHX_HOST=localhost
PHX_SCHEME=http
PHX_URL_PORT=4000
FORCE_SSL=false
